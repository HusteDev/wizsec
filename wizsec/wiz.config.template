app:
  name: ${SDK_NAME}
  release: ${SDK_VERSION}
  config_schema: ${CONFIG_SCHEMA_VERSION}
# serverless: false                   # Enables additional functions to support Serverless execution | default = false
# wiz_dir: ""                         # Default directory for Wiz config, auth, and logging files
# env_path: ""                        # Custom directory for .env file | default = $CWD

# cache:
#   allow_cache: false                # Enable automatic read-through/write-through query caching | default = false
#   backend: filesystem               # Cache backend: filesystem | s3 | dynamodb | default = filesystem
#   directory: ""                     # Filesystem cache directory | default = ~/.wiz/.cache
#   pickle: false                     # Allow pickle files for large filesystem cache entries | default = false
#   default_interval: 1               # Max age of a cached entry before re-fetching (read side) | default = 1
#   default_interval_type: days       # Unit for default_interval: days | minutes | seconds | default = days
#   ttl_seconds: 2592000              # How long to store entries in the backend (write side, 30 days) | default = 2592000
#   s3_bucket: ""                     # S3 bucket name (required when backend=s3)
#   s3_prefix: wizsec-cache           # S3 key prefix | default = wizsec-cache
#   dynamodb_table: ""                # DynamoDB table name (required when backend=dynamodb)
#   aws_region: ""                    # AWS region override for cache backend (falls back to aws.region)
#   aws_profile: ""                   # Named profile from ~/.aws/credentials
#   aws_role_arn: ""                  # IAM role to assume (cross-account access)
#   aws_role_session_name: wizsec-cache  # Session name for assumed role | default = wizsec-cache
#   aws_access_key_id: ""             # Explicit credentials (prefer profile or role_arn instead)
#   aws_secret_access_key: ""
#   aws_session_token: ""

# auth:
#   grant_type: client_credentials    # Options [device_code, client_credentials] | NOTE: device_code requires WizCode license
#   credentials:
#     storage_method: file            # Options [env, file, prompt] | default = file (also checks .env if no file found)
#     file_path: ""                   # Custom directory for credentials | default = $HOME/.wiz/
#   device:
#     quiet: true                     # Device Code logins automatically authorize on load | default = true
#     poll_time: 5                    # Interval (in seconds) for checking if device auth is complete | default = 5
#   proxy:                            # Custom Proxy Settings if necessary | default = use system settings
#     http:
#       url: ""
#       port: 80
#     https:
#       url: ""
#       port: 80
#   ca_cert: ""                       # Path to Custom CA (.pem) file | example: "/cacert.pem"

# domain:                             # Domains not enabled will be blocked from Authentication
#   default: gov                      # Valid Options [app, gov, fedramp] | default = gov
#   app:
#     enabled: false
#   gov:
#     enabled: true
#   fedramp:
#     enabled: false

# api:
#   max_retries: 5                    # Max number of failures before query stops trying | default = 5
#   retry_time: 1                     # Initial wait time for query retry attempts | default = 1
#   timeout: 120                      # Wiz API queries timeout at 2 min | default = 120
#   auto_paginate: true               # Automatically paginate through results | default = true
#   validate_queries: false           # Validate queries against cached Wiz schema before sending | default = false

# reports:
#   stream_by_default: true           # Streaming reports download reports automatically | default = true
#   export_directory: ""              # Path to save report export files | default = working_directory
#   export_type: json                 # Valid Options [json, csv]
#   retry_time: 30                    # Time between attempts to generate a new report | default = 30
#   max_retries: 3                    # Max attempts to run report before reporting failure | default = 3
#   polling_time: 15                  # Time between attempts to check report status | default = 15
#   auto_cleanup: false               # Removes any reports sent to /temp. Deletes old Reports from Wiz
#   save_incomplete_reports: true     # Save partial reports if at least 1 page is successfully retrieved before error

# query_splitting:
#   enabled: false                    # Enable pre-emptive totalCount probe + auto splitting | default = false
#                                     # NOTE: always disabled in serverless mode regardless of this setting
#   threshold: 10000                  # Record count above which splitting is triggered | default = 10000
#   max_concurrent: 10               # Max concurrent async sub-queries when splitting | default = 10
#   detection_mode: static           # "static" = probe only when query already selects totalCount
#                                     # "schema" = use introspection schema to detect eligible queries | default = static
#   split_by: cloudAccounts          # Dimension to split by: "cloudAccounts" (Azure/AWS/GCP accounts)
#                                     # or "projects" (Wiz organizational projects) | default = cloudAccounts
#   filter_path: ""                  # Dot-notation path in vars where entity IDs are injected
#                                     # Required for splitting to function. Examples:
#                                     #   "filterBy.subscriptionId"   (for cloudAccounts)
#                                     #   "filterBy.projectId"        (for projects)
#   cache_subscriptions: true        # Cache entity list per session to avoid re-fetching | default = true

# logging:
#   enabled: false                    # Enables logging for library | default = false
#   verbose: false                    # Enable VERBOSE messages | default = false
#   lowest_level: 10                  # If higher than 10, debug messages will not process for any handler | default = 10
#   debug: false                      # Enable DEBUG messages | default = false
#   file_handler:
#     enabled: false                  # Enables logging to a file | default = false
#     logging_level: DEBUG            # Log level for file handler | default = DEBUG
#     log_directory: ""               # Custom Filepath to save Log Files | default = "$HOME/.wiz" (adds /logs/ folder)
#     create_log_dir: true            # Automatically create the log directory if it does not exist | default = true
#     markdown: false                 # Use Markdown format to put log entries into table format | default = false
#   console_handler:
#     enabled: true                   # Enables logging to console (stdout) | default = true
#     logging_level: INFO             # Log level for console handler | default = INFO
